  "whispers": [
    {"id": "alley", "cell": [37, 8], "radius": 7, "text": "Z mgły na wschodzie dochodzi szuranie i szept: „Trzy kreski… To znowu ty?”"},
    {"id": "warehouse", "cell": [33, 15], "radius": 6, "text": "Zza ścian magazynu niesie się monotonny szept: „Rozpleć, rozpleć, aż nie zostanie imię”."},
    {"id": "arch", "cell": [16, 9], "radius": 8, "text": "Spod Łuku wieje ciepłe powietrze. Ktoś szepcze imię, które kiedyś było twoje, ale wiatr rozwiewa je, zanim je rozpoznasz."}
  ],
  "memories": [
    {"id": "arch_ruts", "cell": [16, 10], "text": "Pod Łukiem bruk jest wytarty w trzy równoległe bruzdy, jakby ktoś latami stawał tu w tym samym miejscu.",
     "journal": "Pod Łukiem bruk ma trzy wytarte bruzdy. Ktoś bardzo długo stał tu na straży."},
    {"id": "pool", "cell": [23, 9], "text": "W wodzie odbija się brama, której nie ma za twoimi plecami. Kiedy mrugasz, odbicie znika.",
     "journal": "W sadzawce na targu zobaczyłem odbicie bramy, której tam nie ma."},
    {"id": "alley_marks", "cell": [37, 9], "text": "Na murze zaułka widać trzy wyblakłe nacięcia, takie same jak znak na twojej dłoni.",
     "journal": "Na murze wschodniego zaułka ktoś wyciął ten sam znak, który noszę na dłoni."},
    {"id": "warehouse_dust", "cell": [33, 14], "text": "W pyle na podłodze magazynu ktoś rysował trzy kreski, raz po raz, jakby uczył się ich na pamięć.",
     "journal": "Rozplatacze rysują w pyle mój znak. Ktoś z nich wie, kim byłem."}
  ],
